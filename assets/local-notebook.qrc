<RCC>
  <!-- The monochrome chrome icons. The PNGs are the embedded form (see
       rasterise.py for how they are produced from the SVGs beside them). The
       alias keeps the resource path flat: :/icons/send.png, not
       :/icons/icons/send.png. -->
  <qresource prefix="/icons">
    <file alias="send.png">icons/send.png</file>
    <file alias="summarize.png">icons/summarize.png</file>
    <file alias="expand.png">icons/expand.png</file>
    <file alias="collapse.png">icons/collapse.png</file>
    <file alias="stop.png">icons/stop.png</file>
    <file alias="new-session.png">icons/new-session.png</file>
    <file alias="copy.png">icons/copy.png</file>
    <file alias="edit.png">icons/edit.png</file>
    <file alias="delete.png">icons/delete.png</file>
    <file alias="settings.png">icons/settings.png</file>
    <file alias="pin.png">icons/pin.png</file>
    <file alias="sidebar.png">icons/sidebar.png</file>
    <file alias="tasks.png">icons/tasks.png</file>
  </qresource>

  <!-- The shipped default theme, so a build carries it even when no
       themes/theme.json sits next to the executable. A theme file on disk still
       wins (see ui::read_theme_root). -->
  <qresource prefix="/themes">
    <file alias="theme.json">../themes/theme.json</file>
  </qresource>

  <!-- The application icon, in every size the desktop asks for. Unlike the
       monochrome composer icons, these are full-colour, so they are embedded
       as-is (no runtime recolouring). See appicon/make_app_icon.py. -->
  <qresource prefix="/appicon">
    <file alias="app-16.png">appicon/app-16.png</file>
    <file alias="app-24.png">appicon/app-24.png</file>
    <file alias="app-32.png">appicon/app-32.png</file>
    <file alias="app-48.png">appicon/app-48.png</file>
    <file alias="app-64.png">appicon/app-64.png</file>
    <file alias="app-128.png">appicon/app-128.png</file>
    <file alias="app-256.png">appicon/app-256.png</file>
    <file alias="app-512.png">appicon/app-512.png</file>
  </qresource>

  <!-- The license texts shown in full on the About page. The MIT text is the
       repository's own LICENSE.txt; the Qt one is the community edition's LGPL
       v3. They are shown verbatim, so they are carried as plain text. -->
  <qresource prefix="/licenses">
    <file alias="mit.txt">../LICENSE.txt</file>
    <file alias="lgpl-3.0.txt">licenses/lgpl-3.0.txt</file>
  </qresource>
</RCC>
